{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic.review-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "round",
    "producer_id",
    "reviewer_id",
    "original_intent",
    "acceptance_criteria",
    "ground_truth",
    "risk_threshold",
    "stop_condition",
    "max_rounds",
    "out_of_scope",
    "files",
    "created_at",
    "request_digest"
  ],
  "properties": {
    "schema": { "const": "agentic.review-request/v1" },
    "task_id": { "type": "string", "minLength": 1 },
    "round": { "type": "integer", "minimum": 1 },
    "producer_id": { "type": "string", "minLength": 1 },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "original_intent": { "type": "string", "minLength": 1 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "ground_truth": {
      "enum": ["mechanical", "documentary", "judgment"]
    },
    "risk_threshold": {
      "enum": ["critical", "high", "medium"]
    },
    "stop_condition": { "type": "string", "minLength": 1 },
    "max_rounds": { "type": "integer", "minimum": 1, "maximum": 2 },
    "out_of_scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": {
            "oneOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "request_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
